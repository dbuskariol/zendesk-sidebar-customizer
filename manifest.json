{
  "manifest_version": 3,
  "name": "Zendesk Sidebar Customizer",
  "version": "0.10.9",
  "description": "Customize the Zendesk Support views sidebar — per-tenant profiles, theming, per-view styling, reorder, live preview.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zendesk Sidebar Customizer",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.zendesk.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zendesk.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.zendesk.com/*"
      ],
      "js": [
        "src/lib.js",
        "src/tickets.js",
        "src/content.js"
      ],
      "css": [
        "src/compact.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zendesk-sidebar-customizer@dbuskariol.github.io",
      "strict_min_version": "128.0"
    }
  }
}
